{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力配置：允许 http 插件与打开外链",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
